{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yappa",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "old.example.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Your Zero Trust team domain, e.g. "https://myteam.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "https://YOUR-TEAM.cloudflareaccess.com",
    // Application Audience (AUD) tag of the existing Access application
    "ACCESS_AUD": "YOUR-ACCESS-APPLICATION-AUD-TAG",
    "TWITCH_CLIENT_ID": "YOUR-TWITCH-CLIENT-ID"
  },
  // Secret (set with `wrangler secret put`): TWITCH_CLIENT_SECRET
  // Client assets are bundled as strings and served by the Worker.
  "rules": [{ "type": "Text", "globs": ["**/client/*.js", "**/client/*.css"], "fallthrough": true }],
  // Lets the Worker and the Durable Object compare which code version each is running.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "COLOR_LOOP", "class_name": "ColorLoop" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ColorLoop"] }]
}
