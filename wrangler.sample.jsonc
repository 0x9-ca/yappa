// Template for wrangler.jsonc. That file is not in git (it holds your own hostnames and IDs).
// Copy this to wrangler.jsonc, replace every YOUR-… placeholder and example.com hostname,
// then run `npm run types`. When the structure below changes (bindings, rules, migrations,
// vars), change it in both files.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yappa",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "observability": { "enabled": true },
  // The app's hostname. To keep an old address working, add it here too: it forwards
  // browsers to APP_HOST (see src/moved.ts).
  "routes": [{ "pattern": "yappa.example.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Who may sign in: Twitch logins and/or numeric Twitch user ids, separated by commas or spaces.
    // An id can't be claimed by someone who later takes over a renamed login. Empty = nobody.
    "ALLOWED_LOGINS": "your_twitch_login",
    // Client ID of your Twitch app (the client secret is a Worker secret, below)
    "TWITCH_CLIENT_ID": "YOUR-TWITCH-CLIENT-ID",
    // The app's address. Opening the app on any other hostname moves you here, bringing
    // along this browser's tabs and settings. Empty = no redirect.
    "APP_HOST": "yappa.example.com"
  },
  // Worker secrets: the Twitch app's client secret (`npx wrangler secret put TWITCH_CLIENT_SECRET`) and a
  // random string of 32+ characters that signs sign-in cookies (`openssl rand -base64 48 | npx wrangler secret put SESSION_SECRET`).
  // Declaring them here types them and makes `wrangler deploy` fail if one is missing.
  "secrets": { "required": ["TWITCH_CLIENT_SECRET", "SESSION_SECRET"] },
  // Client assets are bundled as strings and served by the Worker.
  "rules": [
    { "type": "Text", "globs": ["**/client/*.js", "**/client/*.css", "**/hls.js/dist/hls.light.min.js"], "fallthrough": true },
    { "type": "Data", "globs": ["**/client/icons/*.png"], "fallthrough": true }
  ],
  // Lets the Worker and the Durable Object compare which code version each is running.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "COLOR_LOOP", "class_name": "ColorLoop" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ColorLoop"] }]
}
